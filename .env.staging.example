# Supabase Configuration - STAGING ENVIRONMENT
# Get these values from your Supabase STAGING project settings
#
# Steps to get these values:
# 1. Go to https://supabase.com and sign in
# 2. Select your STAGING project (e.g., fullbodyworkout-staging)
# 3. Go to Settings → API
# 4. Copy the values below
#
# IMPORTANT: This is for STAGING only. Use separate credentials for production.

VITE_SUPABASE_URL=https://your-staging-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key-here

# To use this file:
# 1. Copy this file: cp .env.staging.example .env.staging
# 2. Edit .env.staging with your actual staging credentials
# 3. For local development with staging: npm run dev
# 4. Never commit .env.staging to git (it's in .gitignore)
